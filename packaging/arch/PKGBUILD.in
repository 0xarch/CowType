build() {
  # Do not inherit host-specific -march=native from a local makepkg.conf.
  export CFLAGS='-O2 -pipe -march=x86-64 -mtune=generic'
  export CXXFLAGS="$CFLAGS"
  export RUSTFLAGS="-C target-cpu=x86-64 --remap-path-prefix=$srcdir=/usr/src/cowtype"
  cmake -S "$srcdir/cowtype-$pkgver" -B "$srcdir/native" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_TESTING=OFF \
    -DBOOST_ROOT="${COWTYPE_BOOST_ROOT:-/usr}"
  cmake --build "$srcdir/native" -j2
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/native"
  install -Dm644 "$srcdir/cowtype-$pkgver/docs/USAGE.md" \
    "$pkgdir/usr/share/doc/cowtype/USAGE.md"
}
