pkgver=0.1.0.dev6.3
pkgrel=1
pkgdesc='Experimental CowType Fcitx5 input method with Ice and Wubi dictionaries'
arch=('x86_64')
license=('GPL-3.0-or-later' 'GPL-3.0-only' 'LGPL-3.0-only' 'MIT' 'CC-BY-3.0' 'Apache-2.0' 'ISC' 'Unicode-3.0')
depends=('fcitx5>=5.1.23' 'gtk4' 'libadwaita' 'libime>=1.1.7' 'boost' 'python' 'python-gobject' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja' 'rust' 'cargo')
